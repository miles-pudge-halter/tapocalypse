{
  "name": "tapocalypse",
  "version": "0.1.0",
  "description": "Run parallel, agent-driven QA passes on Android emulators and iOS simulators, with a live web UI and an MCP server your coding agents can dispatch to.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miles-pudge-halter/tapocalypse.git"
  },
  "homepage": "https://github.com/miles-pudge-halter/tapocalypse#readme",
  "bugs": {
    "url": "https://github.com/miles-pudge-halter/tapocalypse/issues"
  },
  "keywords": [
    "mobile",
    "qa",
    "testing",
    "android",
    "ios",
    "flutter",
    "react-native",
    "mcp",
    "ai-agent",
    "emulator",
    "simulator"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "start": "NODE_ENV=production bun src/server.ts",
    "dev": "bun --hot src/server.ts",
    "test": "bun test",
    "doctor": "bun scripts/doctor.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "marked": "^18.1.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
