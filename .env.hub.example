# Copy to .env.hub (git-ignored) and fill in. Used with: docker compose --env-file .env.hub -f compose.hub.yml up -d
# Placeholders only: nothing here is a real credential.
OIDC_CLIENT_ID=<client id registered for the hub at your identity provider>
OIDC_CLIENT_SECRET=<client secret>
# 32 random bytes, base64: `openssl rand -base64 32 | tr -- '+/' '-_'`
OAUTH2_COOKIE_SECRET=<random cookie secret>
